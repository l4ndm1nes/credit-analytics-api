APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=mysql+asyncmy://credit_app:credit_app@db:3306/credit_analytics
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

AUTH_MODE=jwt
JWT_SECRET_KEY=change-me-in-production-at-least-32-symbols-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
API_KEY=change-me-api-key

BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

SEED_ON_STARTUP=true
SEED_DATA_DIR=/app/data
